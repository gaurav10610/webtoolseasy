HOSTNAME=http://localhost:3000
SCREENSHOTS_BASE_URL=/screenshots
GA_CODE=G-XXXXXXX
ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx

# Optional: IndexNow integration
INDEXNOW_API_KEY=your-indexnow-key
INDEXNOW_HOST=webtoolseasy.com

# Optional: Google Indexing API integration
GOOGLE_SERVICE_ACCOUNT_PATH=/absolute/path/to/google-service-account.json
# or
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Workflow platform flags
NEXT_PUBLIC_ENABLE_WORKFLOWS=true
NEXT_PUBLIC_ENABLE_TEMPLATES=true
NEXT_PUBLIC_ENABLE_WORKFLOW_SYNC=false

# Required for shared architecture persistence
DATABASE_URL=postgresql://webtoolseasy:webtoolseasy@localhost:5434/webtoolseasy

# Optional: Plausible analytics (privacy-respecting, no cookies)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=webtoolseasy.com
